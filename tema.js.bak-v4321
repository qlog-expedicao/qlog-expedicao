const EM={"🎧": "suporte", "✅": "ok", "✔": "ok", "❌": "erro", "✖": "erro", "✕": "fechar", "📷": "camera", "📸": "camera", "🖼": "galeria", "🗑": "lixeira", "🔄": "limpar", "🔁": "repetir", "📦": "volume", "✍": "mao", "🧾": "romaneio", "➕": "adicionar", "📝": "pedir", "📤": "compartilhar", "⬆": "compartilhar", "✏": "editar", "💾": "salvar", "🔔": "avisos", "⏳": "espera", "📋": "lista", "⚙": "config", "🐞": "problema", "🚛": "caminhao", "🚚": "caminhao", "🔊": "som", "🔇": "mudo", "👥": "equipe", "📥": "fornecedor", "🔦": "lanterna", "👤": "usuario", "📄": "documento", "📱": "celular", "👷": "colaborador", "👑": "admselo", "⚠": "atencao", "⬅": "voltar", "☑": "marcado", "☐": "desmarcado", "🔑": "chave", "🚫": "bloquear", "🕒": "relogio", "⏱": "relogio", "💻": "notebook", "🚪": "sair", "☁": "nuvem", "▶": "ouvir", "🟫": "palete", "📅": "calendario", "⬇": "baixar", "▮▯": "barras", "🔤": "texto", "🔳": "qr", "☀": "claro", "🌙": "escuro", "🌗": "tema", "🖱": "clique", "🔍": "localizar", "🔎": "localizar", "↩": "estorno", "📊": "relatorio"};
const EMK=Object.keys(EM).sort((a,b)=>b.length-a.length).map(s=>s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'));
const ER=new RegExp('('+EMK.join('|')+')\uFE0F?( ?Arquivo)?','gu');
function emojiKey(e,depois){if(e==='📦'&&depois)return 'arquivo';return EM[e]||'';}
function trocarTexto(t){return t.replace(ER,(m,e,dep)=>'\u0000'+emojiKey(e,dep)+'\u0000'+(dep||''));}
const PULA={SCRIPT:1,STYLE:1,TEXTAREA:1,INPUT:1,SELECT:1,OPTION:1,svg:1,SVG:1,TITLE:1};
function trocarEmojis(raiz){if(!raiz)return;if(raiz.nodeType===3)raiz=raiz.parentNode;if(!raiz||!raiz.ownerDocument&&raiz!==document)return;
 if(raiz.closest&&raiz.closest('svg'))return;
 raiz.querySelectorAll&&raiz.querySelectorAll('option').forEach(o=>{ER.lastIndex=0;if(ER.test(o.textContent)){ER.lastIndex=0;o.textContent=o.textContent.replace(ER,(m,e,dep)=>dep?dep.trim():'').replace(/^\s+/,'');}});
 const w=document.createTreeWalker(raiz,NodeFilter.SHOW_TEXT,{acceptNode:n=>{let p=n.parentNode;while(p&&p!==raiz.parentNode){if(PULA[p.nodeName])return NodeFilter.FILTER_REJECT;p=p.parentNode;}ER.lastIndex=0;return ER.test(n.nodeValue)?NodeFilter.FILTER_ACCEPT:NodeFilter.FILTER_SKIP;}});
 const ns=[];while(w.nextNode())ns.push(w.currentNode);
 for(const n of ns){const partes=trocarTexto(n.nodeValue).split('\u0000');const fr=document.createDocumentFragment();
  partes.forEach((p,i)=>{if(i%2){const s=document.createElement('span');s.className='qx';s.dataset.qk=p;s.innerHTML=ic(p);fr.appendChild(s);}else if(p)fr.appendChild(document.createTextNode(p));});
  n.parentNode.replaceChild(fr,n);}}
function reIcones(){document.querySelectorAll('span.qx[data-qk]').forEach(s=>{s.innerHTML=ic(s.dataset.qk);});}
let obs=null;function ligarIcones(){if(obs||typeof MutationObserver==='undefined'||!document.body)return;trocarEmojis(document.body);
 obs=new MutationObserver(ms=>{for(const m of ms){if(m.type==='characterData')trocarEmojis(m.target);else m.addedNodes.forEach(n=>{if(n.nodeType===1||n.nodeType===3)trocarEmojis(n.nodeType===3?n:n);});}});
 obs.observe(document.body,{childList:true,subtree:true,characterData:true});}
const VOL_PAD=50;// 50 = volume de antes (ganho 0.2)
const ganho=v=>Math.max(0,Math.min(100,Number(v)||0))/250;
const K='qlog_aparencia',PAD={grupo:'simples',tec:'cyber',ic:'colorido',tema:'claro',cor:'azul',bip:'atual',clk:'nao',clkt:'suave'};
const OP={ic:[['linha','1 · Linha simples'],['cheio','2 · Preenchido'],['colorido','3 · Colorido']],
 tema:[['claro','☀️ Claro'],['escuro','🌙 Escuro'],['auto','📱 Automático']],
 bip:[['atual','1 · Atual'],['curto','2 · Curto e agudo'],['duplo','3 · Duplo (bip-bip)']],
 clk:[['nao','Desligado'],['sim','Ligado']],
 clkt:[['suave','1 · Suave'],['tec','2 · Tec (seco)'],['pop','3 · Pop']],
 cor:[['azul','Azul'],['verde','Verde'],['laranja','Laranja'],['roxo','Roxo']],
 grupo:[['simples','Simples'],['tec','Tecnologia']],
 tec:[['cyber','Cyber'],['matrix','Matrix'],['neon','Neon'],['circuito','Circuito']]};
const COR={azul:'#0b4f8a',verde:'#1b7a3a',laranja:'#c2570c',roxo:'#6a3fb5'};
function ler(){let o={};try{o=JSON.parse(localStorage.getItem(K)||'{}')||{};}catch(e){}const r={};for(const k in PAD)r[k]=OP[k].some(x=>x[0]===o[k])?o[k]:PAD[k];const n=Number(o.vol);r.vol=o.vol!=null&&isFinite(n)?Math.max(0,Math.min(100,Math.round(n))):VOL_PAD;const c=Number(o.clkVol);r.clkVol=o.clkVol!=null&&isFinite(c)?Math.max(0,Math.min(100,Math.round(c))):VOL_PAD;return r;}
let A=ler();
function ic(k,st){const g=G[k];if(!g)return '';st=st||A.ic;
 if(st==='linha')return '<svg class="qi" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">'+g.l+'</g></svg>';
 if(st==='cheio')return '<svg class="qi" viewBox="0 0 24 24" aria-hidden="true">'+g.f+'</svg>';
 return '<svg class="qi" viewBox="-6 -6 36 36" aria-hidden="true"><rect x="-6" y="-6" width="36" height="36" rx="9" fill="'+g.c+'"/><g fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'+g.l.replace('r=".6"','r=".9" fill="#fff"')+'</g></svg>';}
// Som do bip (Web Audio, sem arquivos): [freq Hz, duração s, início s]
const SONS={atual:[[1800,.12,0]],curto:[[3000,.05,0]],duplo:[[1800,.07,0],[1800,.07,.12]]};
let AC=null;function bip(v){v=SONS[v]?v:A.bip;try{const C=window.AudioContext||window.webkitAudioContext;if(C&&A.vol>0){AC=AC||new C();if(AC.state==='suspended'&&AC.resume)AC.resume();const t=AC.currentTime;
 for(const [fr,d,ini] of SONS[v]){const o=AC.createOscillator(),g=AC.createGain();o.frequency.value=fr;g.gain.value=ganho(A.vol);o.connect(g);g.connect(AC.destination);o.start(t+ini);o.stop(t+ini+d);}}}catch(e){}
 try{navigator.vibrate&&navigator.vibrate(v==='duplo'?[60,60,60]:80);}catch(e){}}
// Som de clique: [tipo de onda, freq inicial, freq final, duração s, ganho relativo]
const CLIQUES={suave:['sine',900,700,.03,.6],tec:['square',2200,1800,.012,.25],pop:['sine',650,180,.045,.9]};
function ctx(){const C=window.AudioContext||window.webkitAudioContext;if(!C)return null;AC=AC||new C();if(AC.state==='suspended'&&AC.resume)AC.resume();return AC;}
function clique(v){v=CLIQUES[v]?v:A.clkt;if(!(A.clkVol>0))return;try{const c=ctx();if(!c)return;const [w,f1,f2,d,gr]=CLIQUES[v],t=c.currentTime,o=c.createOscillator(),g=c.createGain();
 o.type=w;o.frequency.setValueAtTime(f1,t);o.frequency.exponentialRampToValueAtTime(f2,t+d);g.gain.setValueAtTime(ganho(A.clkVol)*gr,t);g.gain.exponentialRampToValueAtTime(0.0001,t+d);
 o.connect(g);g.connect(c.destination);o.start(t);o.stop(t+d+.01);}catch(e){}}
// toca no pointerdown (antes do click) e não bloqueia a ação
document.addEventListener('pointerdown',e=>{if(A.clk!=='sim')return;const b=e.target.closest&&e.target.closest('button,nav [data-t],[data-open],a');if(!b||b.closest('[data-aptoca],[data-apclk]'))return;clique();},{capture:true,passive:true});
const mq=window.matchMedia?matchMedia('(prefers-color-scheme: dark)'):null;
const escuro=()=>A.grupo==='tec'||A.tema==='escuro'||(A.tema==='auto'&&!!(mq&&mq.matches));
const NAV={nova:'novo',hist:'historico',loc:'localizar',rel:'relatorio',adm:'adm',sobre:'info'};
function aplicar(){const h=document.documentElement;try{reIcones();}catch(e){}h.dataset.tema=escuro()?'escuro':'claro';h.dataset.cor=A.cor;h.dataset.ic=A.ic;if(A.grupo==='tec')h.dataset.estilo=A.tec;else delete h.dataset.estilo;
 document.querySelectorAll('nav button[data-t]').forEach(b=>{const n=b.querySelector('.ni'),k=NAV[b.dataset.t];if(n&&k)n.innerHTML=ic(k);});
 document.querySelectorAll('.supIc').forEach(n=>{n.innerHTML=ic('suporte');});
 const m=document.querySelector('meta[name="theme-color"]');if(m)m.content=A.grupo==='tec'?({cyber:'#050a1f',matrix:'#000000',neon:'#2a0a52',circuito:'#141c26'})[A.tec]:escuro()?'#0d141b':'#354350';}
function salvar(){try{localStorage.setItem(K,JSON.stringify(A));}catch(e){}}
function setVol(v,k){k=k==='clkVol'?'clkVol':'vol';A[k]=Math.max(0,Math.min(100,Math.round(Number(v)||0)));salvar();}
function set(k,v){if(!OP[k]||!OP[k].some(x=>x[0]===v))return;A[k]=v;try{localStorage.setItem(K,JSON.stringify(A));}catch(e){}aplicar();}
function volTxt(v){return v===0?'🔇 mudo':v===100?'🔊 máximo':v+'%';}
let apAberto=false; // começa fechado (minimizado)
function html(ab){const op=ab===true||apAberto;const g=(k,t)=>'<label>'+t+'</label><div class="apg">'+OP[k].map(([v,n])=>(k==='bip'||k==='clkt'?'<span class="apr">':'')+'<button type="button" data-ap="'+k+'" data-v="'+v+'" class="'+(A[k]===v?'on':'')+'">'+(k==='ic'?ic('coleta',v)+' ':k==='cor'?'<i class="apc" style="background:'+COR[v]+'"></i>':'')+n+'</button>'+(k==='clkt'?'<button type="button" class="apt" data-apclk="'+v+'" aria-label="Ouvir">▶️</button>':'')+(k==='bip'?'<button type="button" class="apt" data-aptoca="'+v+'" aria-label="Ouvir">▶️</button>':'')+(k==='bip'||k==='clkt'?'</span>':'')).join('')+'</div>';
 const sl=(k,t,v)=>'<label>'+t+': <span class="apvn" data-vn="'+k+'">'+volTxt(v)+'</span></label><div class="apv"><span>🔇</span><input type="range" min="0" max="100" step="5" value="'+v+'" data-apvol="'+k+'"><span>🔊</span></div>';
 return '<div class="card ap"><b data-apdobra="1" style="display:block;cursor:pointer;font-size:20px;padding:6px 0">'+(op?'▾':'▸')+' ⚙️ Configurações</b>'+(!op?'':'<p><small>Vale só para este celular.</small></p>'+g('grupo','Estilo')+(A.grupo==='tec'?g('tec','Tema tecnologia')+'<p><small>Os temas de tecnologia usam sempre o modo escuro.</small></p>'+g('ic','Tema dos ícones'):g('ic','Tema dos ícones')+g('tema','🌗 Tema do app')+g('cor','Cor principal'))+g('bip','🔔 Som do bip')+sl('vol','🔊 Volume do bip',A.vol)+g('clk','🖱️ Som de clique nos botões')+g('clkt','Tipo do clique')+sl('clkVol','🔊 Volume do clique',A.clkVol))+'</div>';}
document.addEventListener('click',e=>{const ad=e.target.closest('[data-apdobra]');if(ad){e.stopPropagation();apAberto=!apAberto;document.querySelectorAll('.ap').forEach(c=>{const n=document.createElement('div');n.innerHTML=html();c.replaceWith(n.firstChild);});return;}const t=e.target.closest('[data-aptoca]');if(t){e.stopPropagation();bip(t.dataset.aptoca);return;}const tc=e.target.closest('[data-apclk]');if(tc){e.stopPropagation();clique(tc.dataset.apclk);return;}const b=e.target.closest('[data-ap]');if(!b)return;e.stopPropagation();set(b.dataset.ap,b.dataset.v);if(b.dataset.ap==='bip')bip();if(b.dataset.ap==='clkt'||(b.dataset.ap==='clk'&&b.dataset.v==='sim'))clique();
 document.querySelectorAll('.ap').forEach(c=>{const n=document.createElement('div');n.innerHTML=html();c.replaceWith(n.firstChild);});if(window.temaMudou)window.temaMudou();},true);
document.addEventListener('input',e=>{const r=e.target.closest&&e.target.closest('[data-apvol]');if(!r)return;const k=r.dataset.apvol==='clkVol'?'clkVol':'vol';setVol(r.value,k);document.querySelectorAll('.ap [data-apvol="'+k+'"]').forEach(x=>{if(x!==r)x.value=A[k];});document.querySelectorAll('.apvn[data-vn="'+k+'"]').forEach(x=>x.textContent=volTxt(A[k]));},true);
document.addEventListener('change',e=>{const r=e.target.closest&&e.target.closest('[data-apvol]');if(r)r.dataset.apvol==='clkVol'?clique():bip();},true);
if(mq){const f=()=>{if(A.tema==='auto')aplicar();};mq.addEventListener?mq.addEventListener('change',f):mq.addListener&&mq.addListener(f);}
window.Tema={ic,trocarEmojis,trocarTexto,EM,X,clique,CLIQUES,bip,SONS,setVol,ganho,VOL_PAD,set,aplicar,html,get:()=>Object.assign({},A),OP,PAD,COR,G};
aplicar();if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>{aplicar();ligarIcones();});else ligarIcones();
})();
