*{box-sizing:border-box}body{margin:0;font-family:sans-serif;font-size:18px;background:#eef2f6;color:#123}
header{background:#354350;border-bottom:4px solid #3f8a5f;color:#fff;padding:12px 14px;font-size:22px}nav{display:flex;position:sticky;top:0;z-index:5}
nav button{flex:1;min-width:0;padding:14px 4px;font-size:18px;border:0;background:var(--nav);color:var(--ac);font-weight:bold}nav button.on{background:#fff;border-bottom:4px solid var(--ac)}
main{padding:12px;max-width:720px;margin:auto}label{display:block;font-weight:bold;margin:14px 0 6px}
input,select,textarea{width:100%;font-size:20px;padding:12px;border:2px solid #9ab;border-radius:10px;background:#fff}
.row{display:flex;gap:8px}.row>*{flex:1}.big{display:block;width:100%;padding:16px;font-size:20px;font-weight:bold;border:0;border-radius:12px;margin:10px 0;background:var(--ac);color:#fff}
.alt{background:#fff;color:var(--ac);border:2px solid var(--ac)}.ok{background:#1b8a3a}.red{background:#c62828}.tipo button{padding:18px;font-size:20px;border-radius:12px;border:3px solid var(--ac);background:#fff;color:var(--ac);font-weight:bold}
.tipo button.on{background:var(--ac);color:#fff}.fotos{display:flex;flex-wrap:wrap;gap:8px}.fotos div{position:relative}.fotos img{width:96px;height:96px;object-fit:cover;border-radius:8px}
.fotos b{position:absolute;top:-6px;right:-6px;background:#c62828;color:#fff;border-radius:50%;width:30px;height:30px;text-align:center;line-height:30px}
.card{background:#fff;border-radius:12px;padding:12px;margin:10px 0;box-shadow:0 1px 3px #0003}.tag{display:inline-block;padding:2px 8px;border-radius:6px;color:#fff;font-size:14px;font-weight:bold}
.coleta{background:#e67e22}.saida{background:#1b8a3a}table{width:100%;border-collapse:collapse;background:#fff}td,th{padding:8px;border-bottom:1px solid #ccd;text-align:left}
#modal{display:none;position:fixed;inset:0;background:#0008;z-index:9;align-items:flex-start;justify-content:center;padding-top:8vh;box-sizing:border-box;overflow:auto}#modal.on{display:flex}#modal>div{background:#fff;border-radius:14px;padding:18px;width:90%;max-width:420px;box-sizing:border-box;max-height:84vh;overflow:auto}#modal input,#modal select,#modal textarea{box-sizing:border-box;width:100%;display:block}#modal .row .big{margin:10px 0}
#toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#123;color:#fff;padding:12px 18px;border-radius:10px;display:none;z-index:12;pointer-events:none}
.cli{display:flex;flex-wrap:wrap;gap:8px}.cli button{padding:12px 14px;font-size:18px;border-radius:10px;border:2px solid var(--ac);background:#fff;color:var(--ac)}.cli button.on{background:var(--ac);color:#fff}
footer{text-align:center;color:#678;font-size:13px;padding:20px}.err{color:#c62828;font-weight:bold}

.vt small{display:block;font-weight:bold}.tot{font-size:20px}.conf{padding:14px;border-radius:12px;color:#fff;font-weight:bold;font-size:24px;margin:8px 0;text-align:center}.c-ok{background:#1b8a3a}.c-bad{background:#c62828}
table{font-size:15px}
.logo{width:40px;height:40px;vertical-align:middle;background:#fff;border-radius:9px;padding:2px;margin-right:6px}.hg{color:#7fd39e}
.selc{outline:3px solid #d33;background:#fff0f0}

body{padding-left:env(safe-area-inset-left);padding-right:env(safe-area-inset-right);padding-bottom:env(safe-area-inset-bottom)}header{padding-top:calc(12px + env(safe-area-inset-top))}
html,body{overflow-x:hidden;max-width:100vw}.tw{overflow-x:auto;-webkit-overflow-scrolling:touch;max-width:100%}.tw table{font-size:13px}.tw td,.tw th{padding:6px 4px;white-space:nowrap}main{overflow-x:hidden}
#scanner{position:fixed;inset:0;background:#000;z-index:11}#scanner video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.scMask{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}.scBox{width:84%;height:22%;border:4px solid #3f3;border-radius:12px;box-shadow:0 0 0 2000px #0009}
.scTop{position:absolute;top:0;left:0;right:0;padding:18px;color:#fff;text-align:center;font-size:24px;font-weight:bold}.scTop small{font-size:17px;font-weight:normal}
.scBot{position:absolute;bottom:0;left:0;right:0;padding:12px}.scBot .big{margin:6px 0;font-size:22px}
/* v2.8 Recebimento */
.tipo button{padding:14px 2px;font-size:17px}.rec{background:#6a3fb5}
.st{display:inline-block;padding:2px 8px;border-radius:6px;color:#fff;font-size:13px;font-weight:bold}.c-wait{background:#7a8794}.c-dif{background:#d98c00}.c-mais{background:var(--ac)}
.item{display:flex;align-items:center;gap:6px;background:#fff;border-radius:10px;padding:6px 8px;margin:6px 0;box-shadow:0 1px 2px #0002}
.item .icod{flex:1;font-size:19px;font-weight:bold;word-break:break-all}.item button{width:48px;height:48px;font-size:24px;border-radius:10px;border:2px solid var(--ac);background:#fff;color:var(--ac);font-weight:bold}
.item .iqt{min-width:36px;text-align:center;font-size:22px}.item .idel{border-color:#c62828;color:#c62828;font-size:20px}
.grp{margin:10px 0}.gh{color:#fff;font-weight:bold;padding:8px 10px;border-radius:8px}.grp table{font-size:15px}
.scLast{margin-top:8px;font-size:26px;color:#3f3}

.locit{display:flex;gap:8px;align-items:center;background:#fff;color:#1d2731;border:3px solid #9aa7b3;border-radius:12px;padding:10px;margin:8px 0}
.locit.lok{border-color:#1b8a3a;background:#e6f6ea}.locit.lmeio{border-color:var(--ac)}.locit.lduv{border-color:#c9a400;background:#fff6c7}
.locit .lt{flex:1;min-width:0}.locit .lsap{font-size:28px;font-weight:bold;color:#0b2f52;word-break:break-all}
.locit .ldesc{font-size:18px;color:#354350;word-break:break-all}.locit .lcont{font-size:21px;margin-top:4px}.locit .lult{font-size:15px;color:#566;margin-top:4px;word-break:break-all}
.locit .lbt{display:flex;flex-direction:column;align-items:center;gap:4px}.locit .lbt b{font-size:22px}
.locit button{width:56px;height:52px;font-size:26px;border-radius:10px;border:2px solid var(--ac);background:#fff;color:var(--ac);font-weight:bold}

nav{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));overflow:hidden;background:var(--nav)}
nav button{flex:none;min-width:0;padding:6px 1px 4px;display:flex;flex-direction:column;align-items:center;gap:2px;border-bottom:4px solid transparent;overflow:hidden}
nav button .ni{font-size:22px;line-height:1.1}
nav button .nl{font-size:clamp(10px,3.1vw,15px);line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:clip;max-width:100%;letter-spacing:-.2px}
nav button.on{background:var(--ac);color:#fff;border-bottom:4px solid #3f8a5f}

#avBanner{position:fixed;top:10px;left:10px;right:10px;background:#c62828;color:#fff;padding:14px;border-radius:12px;font-size:18px;z-index:13;display:none;box-shadow:0 4px 12px #0005;margin-top:env(safe-area-inset-top)}
.estorno{background:#c62828}

/* v4.3.0 tipo de leitura */
.scModos{display:flex;gap:6px;margin:8px 0 4px;pointer-events:auto}.scModos button{flex:1;font-size:14px;font-weight:bold;padding:8px 4px;border-radius:10px;border:2px solid #fff;background:rgba(0,0,0,.55);color:#fff}.scModos button.on{background:#1b8a3a;border-color:#3f3}
.scTop small{display:block}
nav.seis{grid-template-columns:repeat(6,minmax(0,1fr))}nav.seis button .ni{font-size:20px}nav.seis button .nl{font-size:clamp(9px,2.6vw,14px);letter-spacing:-.3px}

/* v4.3.8 Aparência: cor principal, tema escuro e ícones */
:root{--ac:#0b4f8a;--act:#0b4f8a;--nav:#d6e2ee;--card:#fff}
html[data-cor=verde]{--ac:#1b7a3a;--act:#1b7a3a;--nav:#d4eadb}html[data-cor=laranja]{--ac:#c2570c;--act:#b04e0a;--nav:#f6e0cf}html[data-cor=roxo]{--ac:#6a3fb5;--act:#6a3fb5;--nav:#e3d9f3}
.qi{width:1.25em;height:1.25em;vertical-align:-.25em;flex:none}nav button .ni .qi{width:26px;height:26px;display:block}nav.seis button .ni .qi{width:24px;height:24px}
nav button{--icf:var(--nav)}nav button.on{--icf:var(--ac)}.tipo button{--icf:var(--card);display:flex;flex-direction:column;align-items:center;gap:4px}.tipo button .qi{width:30px;height:30px}.tipo button.on{--icf:var(--ac)}
.apg{display:flex;flex-wrap:wrap;gap:6px}.apg button{flex:1 1 30%;padding:10px 6px;font-size:16px;font-weight:bold;border-radius:10px;border:2px solid var(--ac);background:var(--card);color:var(--act);display:flex;align-items:center;justify-content:center;gap:6px;--icf:var(--card)}
.apg button.on{background:var(--ac);color:#fff;--icf:var(--ac)}.apg .apt{flex:0 0 48px}.apc{display:inline-block;width:18px;height:18px;border-radius:50%;border:2px solid #fff}
.apv{display:flex;align-items:center;gap:8px}.apv input{flex:1;padding:0;accent-color:var(--ac)}
html[data-tema=escuro]{color-scheme:dark;--card:#1d2731;--nav:#16202a}
html[data-tema=escuro][data-cor=azul]{--act:#7cb8f2}html[data-tema=escuro][data-cor=verde]{--act:#6fd39a}html[data-tema=escuro][data-cor=laranja]{--act:#ffa65c}html[data-tema=escuro][data-cor=roxo]{--act:#bda2f2}
html[data-tema=escuro] body{background:#0d141b;color:#e3eaf1}
html[data-tema=escuro] header{background:#16202a}
html[data-tema=escuro] nav button{color:var(--act)}html[data-tema=escuro] nav button.on{color:#fff}
html[data-tema=escuro] .card,html[data-tema=escuro] #modal>div,html[data-tema=escuro] .item,html[data-tema=escuro] table{background:var(--card);color:#e3eaf1}
html[data-tema=escuro] td,html[data-tema=escuro] th{border-color:#334}
html[data-tema=escuro] input,html[data-tema=escuro] select,html[data-tema=escuro] textarea{background:#243240;color:#eef3f8;border-color:#4d6070}
html[data-tema=escuro] .alt,html[data-tema=escuro] .tipo button,html[data-tema=escuro] .cli button,html[data-tema=escuro] .item button,html[data-tema=escuro] .locit button{background:var(--card);color:var(--act);border-color:var(--act)}
html[data-tema=escuro] .tipo button.on,html[data-tema=escuro] .cli button.on{background:var(--ac);color:#fff}
html[data-tema=escuro] .item .idel{color:#ff8a80;border-color:#ff8a80}
html[data-tema=escuro] .err{color:#ff8a80}html[data-tema=escuro] footer{color:#8a9bab}html[data-tema=escuro] #toast{background:#e3eaf1;color:#0d141b}
html[data-tema=escuro] .selc{background:#3a1c1c}
html[data-tema=escuro] .locit{background:var(--card);color:#e3eaf1}html[data-tema=escuro] .locit.lok{background:#173a22}html[data-tema=escuro] .locit.lduv{background:#3a3310}
html[data-tema=escuro] .locit .lsap{color:#cfe3f7}html[data-tema=escuro] .locit .ldesc{color:#c3ced8}html[data-tema=escuro] .locit .lult{color:#9fb0bf}
html[data-tema=escuro] [style*="color:#354350"],html[data-tema=escuro] [style*="color:#0b4f8a"]{color:var(--act)!important}
html[data-tema=escuro] [style*="color:#678"]{color:#9fb0bf!important}
html[data-tema=escuro] [style*="background:#fdeeee"]{background:#3a1f22!important}html[data-tema=escuro] [style*="background:#e8f1fb"],html[data-tema=escuro] [style*="background:#eef3f8"]{background:#1c2c3d!important}
html[data-tema=escuro] [style*="background:#fff3a0"]{background:#4a4210!important;color:#fff3a0!important}html[data-tema=escuro] [style*="background:#dde"]{background:#2b3440!important}
html[data-tema=escuro] [style*="background:#fff;"]{background:var(--card)!important;color:#e3eaf1}
html[data-tema=escuro] [style*="border-bottom:1px solid #ddd"]{border-color:#334!important}
.apr{display:flex;gap:6px;flex:1 1 100%}.apr button[data-ap]{flex:1}
html[data-tema=escuro] img[src="logo.png"]{background:#eef2f6;border-radius:14px;padding:8px}
#updBan{position:fixed;left:10px;right:10px;bottom:calc(14px + env(safe-area-inset-bottom));z-index:12;display:none;align-items:center;gap:8px;background:#1b8a3a;color:#fff;padding:10px 12px;border-radius:12px;box-shadow:0 4px 12px #0005;font-weight:bold}#updBan span{flex:1}#updBan button{border:0;border-radius:8px;padding:10px 12px;font-size:17px;font-weight:bold;background:#fff;color:#1b8a3a}#updBan #updBanX{background:transparent;color:#fff}

/* v4.3.18: ícones próprios no lugar dos emojis */
.qx{display:inline;white-space:nowrap}.qx .qi{width:1.2em;height:1.2em;vertical-align:-.22em}

/* v4.3.18: sem estouro lateral */
*,*::before,*::after{box-sizing:border-box}html,body{max-width:100%;overflow-x:hidden}img,input,select,textarea,button,.card,table{max-width:100%}.card,label,b,small,span,p{overflow-wrap:anywhere}.eqp{overflow-x:hidden}.acts{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}.acts .big{flex:1 1 calc(50% - 6px);min-width:0;width:auto;margin:0;font-size:16px;padding:10px 8px;white-space:normal}
footer{overflow-wrap:anywhere;line-height:1.5;padding:16px 12px}
.tipo button span,button span,button b,nav span{overflow-wrap:normal;word-break:normal}.tipo button{min-width:0;padding-left:4px;padding-right:4px}@media(max-width:400px){.tipo button span{font-size:15px}}
/* v4.3.18 */.supBtn{background:none;border:1.5px solid #0b4f8a;color:#0b4f8a;border-radius:20px;padding:6px 14px;font-size:14px;margin:0 0 8px;cursor:pointer;max-width:100%}.supBtn .qi{width:1.2em;height:1.2em;vertical-align:-.25em;margin-right:4px}footer small{font-size:11px}.chN:not(:empty){background:#e08a00;color:#fff;border-radius:10px;padding:0 7px;margin-left:4px;font-size:14px}.admsubs .big{flex:1 1 calc(50% - 8px);min-width:0}html[data-tema=escuro] .supBtn{color:#8cc4ff;border-color:#8cc4ff}
